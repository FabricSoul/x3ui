<version>1</version>
<engineversion>40</engineversion>
<description>x3ui v4: PROBE beacon + inline movestation.std body ([PLAYERSHIP] actor, op538+519+inline102)</description>
<arguments>
</arguments>
<sourceplaintext>
<![CDATA[
  set global variable: name='X3UI.PROBE' value=424242
  $here = [PLAYERSHIP] -> get environment
  $sector = [PLAYERSHIP] -> get sector
  $stations = $sector -> get station array from sector
  $n = size of array $stations
  while $n
    dec $n =
    $s = $stations[$n]
    skip if $s != $here
      continue
    [PLAYERSHIP] -> set command: COMMAND_DOCKAT  target=$s target2=null par1=null par2=null
    [PLAYERSHIP] -> set destination to $s
@   = [PLAYERSHIP] -> call script '!move.movetostation' :  station=$s
    return null
  end
  return null
]]>
</sourceplaintext>
