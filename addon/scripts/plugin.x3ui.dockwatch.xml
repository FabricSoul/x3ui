<script>
<name>plugin.x3ui.dockwatch</name>
<version>1</version>
<engineversion>40</engineversion>
<description>x3ui bridge: poll X3UI.DOCKAT, START player ship docking</description>
<arguments>
</arguments>
<sourceplaintext>
<![CDATA[
loop:
@             = wait 500 ms
  $t = get global variable: name='X3UI.DOCKAT'
  if $t
   set global variable: name='X3UI.DOCKAT' value=null
@    START [PLAYERSHIP] -> call script '!ship.cmd.movestation.std' :  object=$t
  end
  goto label loop
  return null
]]>
</sourceplaintext>
