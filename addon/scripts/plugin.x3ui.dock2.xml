  [PLAYERSHIP] ->set command: COMMAND_DOCKAT  target=$object target2=null par1=null par2=null
  [PLAYERSHIP] ->set destination to $object
@ START [PLAYERSHIP] -> call script !move.movetostation :  station=$object
  return null
]]>
