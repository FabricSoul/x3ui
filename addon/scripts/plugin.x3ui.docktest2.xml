<script>
<name>plugin.x3ui.docktest2</name>
<version>1</version>
<engineversion>40</engineversion>
<description>x3ui one-shot v2: INLINE call movestation.std on [THIS] to dock the player</description>
<arguments>
</arguments>
<sourceplaintext>
<![CDATA[
  $here = [PLAYERSHIP] -> get environment
  $sector = [PLAYERSHIP] -> get sector
  $stations = $sector -> get station array from sector
  $n = size of array $stations
  while $n
    dec $n =
    $s = $stations[$n]
    skip if $s != $here
      continue
@   = [THIS] -> call script '!ship.cmd.movestation.std' :  object=$s
    return null
  end
  return null
]]>
</sourceplaintext>
